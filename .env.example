# Browser and hosting (written to .env.local by `npm run setup`)
# Set true for the account-free local product sandbox. The CLI manages this.
NEXT_PUBLIC_TEST_MODE=false
NEXT_PUBLIC_DEMO_MODE=false
NEXT_PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_replace_me
CLERK_SECRET_KEY=sk_test_replace_me
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=VideoFlow
NEXT_PUBLIC_APP_LOGO_URL=/logo.svg
NEXT_PUBLIC_BRAND_COLOR=#6d5bfc
NEXT_PUBLIC_MAX_RECORDING_MINUTES=15
NEXT_PUBLIC_MAX_VIDEO_BYTES=524288000

# Optional feature switches. Omit them to use the current VideoFlow defaults.
NEXT_PUBLIC_FEATURE_MOBILE_CAMERA_SWITCH=true
NEXT_PUBLIC_FEATURE_LIBRARY_DELETE=true
NEXT_PUBLIC_FEATURE_REVIEW_REQUESTS=true
NEXT_PUBLIC_FEATURE_AUTOMATIC_TASKS=true
NEXT_PUBLIC_FEATURE_SOCIAL_PUBLISHING=true
NEXT_PUBLIC_FEATURE_ZERNIO=false

# Convex server environment (the setup wizard sends these directly to Convex)
# CLERK_JWT_ISSUER_DOMAIN=https://your-instance.clerk.accounts.dev
# R2_TOKEN=replace_me
# R2_ACCESS_KEY_ID=replace_me
# R2_SECRET_ACCESS_KEY=replace_me
# R2_ENDPOINT=https://account-id.r2.cloudflarestorage.com
# R2_BUCKET=videoflow
# APP_URL=https://video.example.com
# APP_NAME=VideoFlow
# BRAND_COLOR=#6d5bfc
# MAX_VIDEO_BYTES=524288000

# Optional background media worker. Set the same random value in Convex and the worker process.
# MEDIA_WORKER_SECRET=generate_an_independent_32_byte_value
# Worker process only: VIDEOFLOW_APP_URL=https://video.example.com
# One social worker process per destination:
# SOCIAL_CONNECTION_ID=copy_from_the_editor
# SOCIAL_CONNECTION_SECRET=copy_the_one_time_binding_secret
# SOCIAL_PROVIDER_ACCESS_TOKEN=provider_access_token_from_a_secret_store
# LinkedIn worker only: LINKEDIN_VERSION=202607
# LINKEDIN_OWNER_URN=urn:li:person:replace_me
# Zernio worker only: ZERNIO_API_KEY=sk_replace_me

# Optional transcription: choose one provider
# TRANSCRIPTION_PROVIDER=openai
# OPENAI_API_KEY=replace_me
# OPENAI_TRANSCRIPTION_MODEL=whisper-1
# OPENAI_DOCUMENT_MODEL=gpt-4.1-mini
# TRANSCRIPTION_PROVIDER=openrouter
# OPENROUTER_API_KEY=replace_me
# OPENROUTER_TRANSCRIPTION_MODEL=openai/whisper-large-v3

# Optional email notifications
# RESEND_API_KEY=replace_me
# NOTIFICATION_FROM_EMAIL=notifications@example.com

# Separate browser-only sales-demo deployment (see docs/SALES_DEMO.md)
# NEXT_PUBLIC_DEMO_MODE=true
# NEXT_PUBLIC_DEMO_PURCHASE_URL=https://example.com/buy
# NEXT_PUBLIC_DEMO_PRIVACY_URL=https://example.com/privacy
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=replace_with_your_cloudflare_turnstile_site_key
# NEXT_PUBLIC_DEMO_MAX_RECORDING_MINUTES=15
# NEXT_PUBLIC_DEMO_MAX_VIDEO_BYTES=524288000
# NEXT_PUBLIC_DEMO_MAX_VIDEOS=10
# DEMO_SESSION_SECRET=generate_an_independent_32_byte_value
# DEMO_RATE_LIMIT_SECRET=generate_an_independent_32_byte_value
# TURNSTILE_SECRET_KEY=replace_with_your_cloudflare_turnstile_secret_key
# DEVLAUNCH_CONVEX_URL=https://your-devlaunch-deployment.convex.cloud
# VIDEOFLOW_DEMO_INGEST_TOKEN=use_the_same_32_byte_value_in_videoflow_and_devlaunch
# Demo-only OpenRouter key. Create a separate key with a small credit cap and an
# OpenRouter guardrail that allows only the two models below and requires ZDR.
# DEMO_OPENROUTER_API_KEY=replace_with_a_rotated_demo_only_key
# DEMO_OPENROUTER_GENERATION_MODEL=openai/gpt-5.4-nano
# DEMO_OPENROUTER_TRANSCRIPTION_MODEL=openai/whisper-large-v3
# DevLaunch Convex-only: VIDEOFLOW_DEMO_ACCESS_PEPPER=generate_an_independent_32_byte_value
# DevLaunch Convex-only: RESEND_API_KEY=replace_me
# DevLaunch Convex-only: VIDEOFLOW_DEMO_EMAIL_FROM=VideoFlow <demo@example.com>
